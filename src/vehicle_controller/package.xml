<?xml version="1.0"?>
<package format="3">
  <name>vehicle_controller</name>
  <version>0.1.0</version>
  <description>Simple safe ros2_control vehicle controller.</description>
  <maintainer email="caoquangddon5@gmail.com">ddon</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>realtime_tools</depend>
  <depend>vehicle_msgs</depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_system_handler</exec_depend>
  <exec_depend>odrive_can_interface</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
